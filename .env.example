# Local Next.js (`npm run dev`, `npm start`, and `vercel dev`) reads the
# Development values. Any Vercel deployment (preview or production) reads
# the Production values. Do not prefix these with NEXT_PUBLIC_.

RULECMS_DEVELOPMENT_TOKEN=
RULECMS_PRODUCTION_TOKEN=

# Nested collections page (/scenarios/nested-collections).
# Development: draft widget key from the Development environment.
# Production: published widget key from the Production environment.
RULECMS_WIDGET_KEY_NESTED_COLLECTIONS_DEVELOPMENT=
RULECMS_WIDGET_KEY_NESTED_COLLECTIONS_PRODUCTION=

# Text component page (/scenarios/text-component).
# Development: draft widget key from the Development environment.
# Production: published widget key from the Production environment.
RULECMS_WIDGET_KEY_TEXT_COMPONENT_DEVELOPMENT=
RULECMS_WIDGET_KEY_TEXT_COMPONENT_PRODUCTION=

# Collection with a child collection that reads {{ price }} (/scenarios/collection-dynamic-price).
# Development: draft widget key from the Development environment.
# Production: published widget key, after the widget is published.
RULECMS_WIDGET_KEY_COLLECTION_DYNAMIC_PRICE_DEVELOPMENT=
RULECMS_WIDGET_KEY_COLLECTION_DYNAMIC_PRICE_PRODUCTION=

# Two embedded collection trees, each with its own price (/scenarios/two-embedded-price-trees).
# Development: draft widget key from the Development environment.
# Production: published widget key, after the widget is published.
RULECMS_WIDGET_KEY_TWO_EMBEDDED_PRICE_TREES_DEVELOPMENT=
RULECMS_WIDGET_KEY_TWO_EMBEDDED_PRICE_TREES_PRODUCTION=

# Further pages: RULECMS_WIDGET_KEY_<SLUG>_DEVELOPMENT and
# RULECMS_WIDGET_KEY_<SLUG>_PRODUCTION, with <SLUG> uppercased.
